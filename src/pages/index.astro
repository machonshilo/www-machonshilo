---
import Base from "@/components/layouts/Base.astro";
---

<Base title="Machon Shilo" description="Torah for those who dare to think.">
    <ul>
        <li><a href="/en" class="basic">English</a></li>
        <li dir="rtl"><a href="/he" class="basic">עברית</a></li>
    </ul>
</Base>

<style is:inline>
    ul {
        list-style: none;
        text-align: center;
        align-self: center;
        font-size: var(--font-size-2xl);
    }
    a {
        color: var(--color-text);
        display: inline-block;
        transition: transform 0.3s ease;
    }
    a:hover {
        transform: scale(1.15);
        color: var(--color-blue);
    }
</style>
