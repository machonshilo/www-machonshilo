---
import Base from "@/components/layouts/Base.astro";
---

<Base title="Machon Shilo" description="Torah for those who dare to think.">
    <main>
        <ul>
            <li><a href="/en">English</a></li>
            <li dir="rtl"><a href="/he">עברית</a></li>
        </ul>
    </main>
</Base>

<style>
    main {
        display: grid;
        place-items: center;
        min-height: 100vh;
        text-align: center;
        font-size: var(--font-size-2xl);
    }
    ul {
        list-style: none;
    }
    a {
        text-decoration: none;
    }
    a:visited {
        color: var(--color-text);
    }
    li:hover {
        text-shadow: 0px 4px 10px var(--color-blue);
    }
</style>
