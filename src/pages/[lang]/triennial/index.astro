---
import { i18n } from "astro:config/client";
import { getCollection } from "astro:content";

import Post from "@/components/layouts/Post.astro";

export async function getStaticPaths() {
    const locales = i18n?.locales || [];

    return locales.map((lang) => {
        return { params: { lang } };
    });
}

const { lang } = Astro.params;

const translations = {
    en: { title: "Triennial Cycle", description: "" },
    he: { title: "Triennial Cycle", description: "" },
};

const props = translations[lang as keyof typeof translations];

const posts = await getCollection("triennial");
---

<Post title={props.title} description={props.description}>
    <h1>{props.title}</h1>
    <ul>
        {
            posts.map((post) => (
                <li>
                    <a href=`/${lang}/triennial/${post.id}`>{post.id}</a>
                </li>
            ))
        }
    </ul>
</Post>
