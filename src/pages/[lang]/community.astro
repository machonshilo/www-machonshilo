---
import { i18n } from "astro:config/client";

import Post from "@/components/layouts/Post.astro";

export async function getStaticPaths() {
    const locales = i18n?.locales || [];

    return locales.map((lang) => {
        return { params: { lang } };
    });
}

const { lang } = Astro.params;

const translations = {
    en: { title: "Community", description: "" },
    he: { title: "", description: "" },
};

const props = translations[lang as keyof typeof translations];
---

<Post title={props.title} description={props.description}>
    <h1>{props.title}</h1>
</Post>
