const props = translations[lang as keyof typeof translations];
---

<Post title={props.title} description={props.description}>
    <h1>{props.content.welcome}</h1>

    <!-- Classes Section -->
    <section class="classes-section">
        <h2>{props.content.classesTitle}</h2>

        <div class="class-card">
            <h3>{props.content.monthlyTitle}</h3>
            <h4>{props.classes.monthly.title}</h4>
            <p>{props.classes.monthly.description}</p>
            <p class="location">
                <strong>{props.content.locationLabel}:</strong>
                {props.classes.monthly.location}
            </p>
        </div>

        <div class="class-card">
            <h3>{props.content.weeklyTitle}</h3>
            <h4>{props.classes.weekly.title}</h4>
            <p>{props.classes.weekly.description}</p>
            <p class="location">
                <strong>{props.content.locationLabel}:</strong>
                {props.classes.weekly.location}
            </p>
        </div>

        <div class="whatsapp-box">
            <h3>{props.content.missedClassTitle}</h3>
            <p>
                <!-- Replace '#' with your actual WhatsApp community invite link token -->
                <a
                    href="#"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="whatsapp-link"
                >
                    {props.content.whatsappText}
                </a>
            </p>
        </div>
    </section>

    <!-- Leadership Contacts Section -->
    <section class="contacts-section">
        <h2>{props.content.reachOut}</h2>
        <ul class="contacts-list">
            {
                props.localContacts.map((item) => (
                    <li>
                        <strong>{item.location}:</strong> {item.leader} —
                        <Link dir="ltr" href={`mailto:${item.contact}`}>
                            {item.contact}
                        </Link>
                    </li>
                ))
            }
        </ul>
    </section>

    <!-- General Inquiries -->
    <section class="general-section">
        <h2>{props.content.general}</h2>
        <p>
            <a href={`mailto:${props.content.office}`}>{props.content.office}</a
            >
        </p>
    </section>
</Post>
