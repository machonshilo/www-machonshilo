---
import { i18n } from "astro:config/client";

import Page from "@/components/layouts/Page.astro";

import FeaturedPost from "@/components/ui/FeaturedPost.astro";
import SeasonalPosts from "@/components/ui/SeasonalPosts.astro";
import TriennialReading from "@/components/ui/TriennialReading.astro";
import RecentPosts from "@/components/ui/RecentPosts.astro";
import MeetTheRabbi from "@/components/ui/MeetTheRabbi.astro";

export async function getStaticPaths() {
    const locales = i18n?.locales || [];

    return locales.map((lang) => {
        return { params: { lang } };
    });
}

const { lang } = Astro.params;

const translations = {
    en: {
        title: "Home",
        description: "For Those Who Dare To Think",
        siteName: "Machon Shilo",
    },
    he: {
        title: "Home",
        description: "For Those Who Dare To Think",
        siteName: "Machon Shilo",
    },
};

const props = translations[lang as keyof typeof translations];
---

<Page title={props.title} description={props.description}>
    <FeaturedPost />
    <SeasonalPosts />
    <TriennialReading />
    <RecentPosts />
    <MeetTheRabbi />
</Page>

<style>
    :global(main) {
        grid-column: 2 / -2;
    }
    :global(section) {
        background-color: var(--color-bg-card);
        margin: var(--space-sm);
        padding: var(--space-sm);
    }
</style>
