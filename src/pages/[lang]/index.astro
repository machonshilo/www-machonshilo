---
import Page from "@/components/layouts/Page.astro";

export function getStaticPaths() {
    return [{ params: { lang: "en" } }, { params: { lang: "he" } }];
}

const lang = Astro.currentLocale ?? "en";

const props = {
    en: { title: "Home" },
    he: { title: "בית" },
}[lang];
---

<Page title={props.title}> {props.title} </Page>
