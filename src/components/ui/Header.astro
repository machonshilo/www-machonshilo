---
const lang = Astro.currentLocale ?? "en";
const currentPath = Astro.url.pathname;

const translations = {
    en: {
        siteName: "Machon Shilo",
        links: [
            { href: "/en", text: "Home" },
            { href: "/en/community", text: "Community" },
            { href: "/en/ask", text: "Ask The Rabbi" },
            { href: "/en/triennial", text: "Triennial Cycle" },
            { href: "/en/donate", text: "Donate" },
        ],
    },
    he: {
        siteName: "מכון שילה",
        links: [
            { href: "/he", text: "בית" },
            { href: "/he/community", text: "קהילה" },
            { href: "/he/ask", text: "שאל את הרב" },
            { href: "/he/triennial", text: "מחזור התלת שנתי" },
            { href: "/he/donate", text: "לתרום" },
        ],
    },
};

const props =
    translations[lang as keyof typeof translations] ?? translations.en;
---

<header>
    <nav>
        <button
            id="menu-toggle"
            aria-label="Toggle navigation menu"
            aria-expanded="false"
        >
            <svg
                width="1.5rem"
                height="1.5rem"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
            >
                <line x1="3" y1="5" x2="21" y2="5"></line>
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="19" x2="21" y2="19"></line>
            </svg>
        </button>

        <ul id="nav-links">
            {
                props.links.map((link) => {
                    const isActive =
                        currentPath === link.href ||
                        (link.href !== "/" &&
                            currentPath.startsWith(link.href));

                    return (
                        <li>
                            <a
                                href={link.href}
                                class:list={["basic", { active: isActive }]}
                            >
                                {link.text}
                            </a>
                        </li>
                    );
                })
            }
        </ul>
    </nav>
</header>

<style>
    header {
        grid-column: 1 / -1;
        display: flex;
        flex-direction: row;
    }

    nav {
        display: flex;
        flex-direction: row;
    }

    ul {
        display: flex;
        flex-direction: row;
    }

    a {
        color: var(--color-text);
    }
    a:hover {
        color: var(--color-blue);
    }
    a.active {
        font-weight: bold;
    }
</style>
