---
const lang = Astro.currentLocale ?? "en";
const currentPath = Astro.url.pathname.replace(/\/$/, "");

const translations = {
    en: {
        siteName: "Machon Shilo",
        links: [
            { href: "/en", text: "Home" },
            { href: "/en/community", text: "Community" },
            { href: "/en/ask", text: "Ask The Rabbi" },
            { href: "/en/triennial", text: "Triennial Cycle" },
            { href: "/en/donate", text: "Donate" },
        ],
    },
    he: {
        siteName: "מכון שילה",
        links: [
            { href: "/he", text: "בית" },
            { href: "/he/community", text: "קהילה" },
            { href: "/he/ask", text: "שאל את הרב" },
            { href: "/he/triennial", text: "מחזור התלת שנתי" },
            { href: "/he/donate", text: "לתרום" },
        ],
    },
};

const props =
    translations[lang as keyof typeof translations] ?? translations.en;

const isGlass = currentPath === "/en" || currentPath === "/he";
---

<header id="main-header" class={isGlass ? "glass" : undefined}>
    <nav class="nav-container">
        <a href={props.links[0].href} class="site-logo">
            {props.siteName}
        </a>

        <button
            id="menu-toggle"
            aria-label="Toggle navigation menu"
            aria-expanded="false"
        >
            <svg
                width="1.5rem"
                height="1.5rem"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
            >
                <line x1="3" y1="5" x2="21" y2="5"></line>
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="19" x2="21" y2="19"></line>
            </svg>
        </button>

        <ul id="nav-links">
            {
                props.links.map((link) => {
                    const linkPath = link.href.replace(/\/$/, "");

                    const isHome =
                        linkPath === "/en" ||
                        linkPath === "/he" ||
                        linkPath === "";
                    const isActive = isHome
                        ? currentPath === linkPath
                        : currentPath.startsWith(linkPath);

                    return (
                        <li>
                            <a
                                href={link.href}
                                class={isActive ? "active" : undefined}
                            >
                                {link.text}
                            </a>
                        </li>
                    );
                })
            }
        </ul>
    </nav>
</header>

<script>
    const button = document.getElementById("menu-toggle");
    const header = document.getElementById("main-header");

    button?.addEventListener("click", () => {
        const isOpen = header?.classList.toggle("menu-open");
        button.setAttribute("aria-expanded", isOpen ? "true" : "false");
    });
</script>

<style>
    header {
        background-color: var(--color-bg);
        box-shadow:
            0px 0px 4px oklch(0.7 0 0),
            0px 0px 12px oklch(0.8 0 0);
        position: sticky;
        top: 0;
        z-index: 100;
        padding: 1rem 2rem;
        transition:
            background-color 0.3s ease,
            backdrop-filter 0.3s ease;
    }

    header.glass {
        background-color: rgba(255, 255, 255, 0.4); /* Fallback style */
        background-color: oklch(from var(--color-bg, #ffffff) l c h / 0.7);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
    }

    .nav-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        max-width: 1200px;
        margin: auto;
    }

    .site-logo {
        font-weight: bold;
        font-size: 1.25rem;
        text-decoration: none;
        color: var(--color-text);
    }

    ul {
        display: flex;
        gap: 1.5rem;
        list-style: none;
    }

    a {
        text-decoration: none;
        color: var(--color-text);
        font-size: 1rem;
        transition: color 0.2s ease;
    }
    a:hover,
    a:focus {
        color: var(--color-blue);
    }
    a.active {
        font-weight: bold;
        color: var(--color-blue);
    }

    button {
        display: none;
        background: none;
        border: none;
        color: var(--color-text);
        cursor: pointer;
        padding: 0.5rem;
    }

    @media (max-width: 700px) {
        button {
            display: block;
        }

        ul {
            display: none;
            flex-direction: column;
            position: absolute;
            top: 100%;
            inset-inline-start: 0;
            width: 100%;
            background-color: var(--color-bg);
            padding: 1.5rem 2rem;
            box-shadow: 0px 8px 16px rgba(0, 0, 0, 0.1);
            gap: 1.25rem;
        }

        header.glass ul {
            background-color: oklch(from var(--color-bg) l c h / 0.95);
            backdrop-filter: blur(12px);
        }

        header.menu-open ul {
            display: flex;
        }
    }
</style>
