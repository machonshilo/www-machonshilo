---
import Head from "@/components/Head.astro";

interface Props {
    title: string;
    description: string;
    imgSrc?: string;
    imgAlt?: string;
    type?: "website" | "article";
    authorTwitter?: string;
}

const lang = Astro.currentLocale ?? "en";
---

<html lang={lang} dir={lang == "he" ? "rtl" : "ltr"}>
    <Head {...Astro.props}>
        <slot name="head" />
    </Head>
    <body>
        <slot />
    </body>
</html>

<style is:global>
    :root {
        --color-bg-light: oklch(0.985 0.01 84.583);
        --color-bg: oklch(0.95 0.015 84.583);
        --color-bg-card: oklch(0.88 0.02 84.583);

        --color-text-muted: oklch(0.35 0.01 25.858);
        --color-text: oklch(0.189 0.015 25.858);

        --color-primary: oklch(0.428 0.172 259.702);
        --color-primary-hover: oklch(0.35 0.16 259.702);

        --font-size-xs: clamp(0.7813rem, 0.7736rem + 0.0341vw, 0.8rem);
        --font-size-sm: clamp(0.9375rem, 0.9119rem + 0.1136vw, 1rem);
        --font-size-md: clamp(1.125rem, 1.0739rem + 0.2273vw, 1.25rem);
        --font-size-lg: clamp(1.35rem, 1.2631rem + 0.3864vw, 1.5625rem);
        --font-size-xl: clamp(1.62rem, 1.4837rem + 0.6057vw, 1.9531rem);
        --font-size-2xl: clamp(1.944rem, 1.7405rem + 0.9044vw, 2.4414rem);
        --font-size-3xl: clamp(2.3328rem, 2.0387rem + 1.3072vw, 3.0518rem);
        --font-size-4xl: clamp(2.7994rem, 2.384rem + 1.8461vw, 3.8147rem);

        --line-height: calc(1em + 0.5rem);

        --max-width: 1200px;
        --max-width-article: 65rch;

        --space-3xs: clamp(0.3125rem, 0.3125rem + 0vw, 0.3125rem);
        --space-2xs: clamp(0.5625rem, 0.5369rem + 0.1136vw, 0.625rem);
        --space-xs: clamp(0.875rem, 0.8494rem + 0.1136vw, 0.9375rem);
        --space-sm: clamp(1.125rem, 1.0739rem + 0.2273vw, 1.25rem);
        --space-md: clamp(1.6875rem, 1.6108rem + 0.3409vw, 1.875rem);
        --space-lg: clamp(2.25rem, 2.1477rem + 0.4545vw, 2.5rem);
        --space-xl: clamp(3.375rem, 3.2216rem + 0.6818vw, 3.75rem);
        --space-2xl: clamp(4.5rem, 4.2955rem + 0.9091vw, 5rem);
        --space-3xl: clamp(6.75rem, 6.4432rem + 1.3636vw, 7.5rem);

        --radius: 4px;
    }

    *,
    *::before,
    *::after {
        box-sizing: border-box;

        &:not(dialog) {
            margin: 0;
            padding: 0;
        }
    }

    html {
        color-scheme: light dark;
        scrollbar-gutter: stable;
        -webkit-text-size-adjust: none;
        text-size-adjust: none;
        -webkit-font-smoothing: antialiased;

        &.translated-rtl {
            direction: rtl;
        }
        &.translated-ltr {
            direction: ltr;
        }

        @media (prefers-reduced-motion: no-preference) {
            interpolate-size: allow-keywords;
            &:focus-within {
                scroll-behavior: smooth;
            }
        }
    }

    body {
        min-height: 100vh;
        display: grid;
        grid-template-columns:
            var(--space-md)
            1fr
            min(var(--max-width-article), 100% - 2 * var(--space-md))
            1fr
            var(--space-md);

        background-color: var(--color-bg);

        font-family: var(--font-frank);
        font-size: var(--font-size-md);
        line-height: var(--line-height);
        color: var(--color-text);
    }

    body > * {
        grid-column: 3;
    }

    p {
        text-wrap: pretty;
        overflow-wrap: break-word;
        margin-bottom: var(--space-xs);
    }

    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
        font-family: var(--font-suez);
        text-wrap: balance;
        overflow-wrap: break-word;
        letter-spacing: -0.02em;
        margin-top: var(--space-sm);
        margin-bottom: var(--space-2xs);
    }

    h1 {
        font-size: var(--font-size-2xl);
    }
    h2 {
        font-size: var(--font-size-xl);
    }
    h3 {
        font-size: var(--font-size-lg);
    }

    a {
        color: var(--color-primary);
        text-decoration: none;
        background-image: linear-gradient(
            var(--color-primary),
            var(--color-primary)
        );
        background-size: 0% 4px;
        background-repeat: no-repeat;
        background-position: left bottom;
        transition: background-size 0.3s ease;

        &:dir(rtl) {
            background-position: right bottom;
        }

        &:hover:not(.basic) {
            background-size: 100% 4px;
        }
    }

    svg {
        fill: currentColor;
    }

    img,
    picture,
    video,
    canvas,
    svg {
        display: block;
        max-width: 100%;
        height: auto;
    }

    input,
    button,
    textarea,
    select {
        font: inherit;
    }

    input:where(
            [type="tel"],
            [type="url"],
            [type="email"],
            [type="number"]
        ):not(:placeholder-shown) {
        direction: ltr;
    }
</style>
