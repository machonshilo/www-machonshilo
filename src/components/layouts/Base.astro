---
import Head from "@/components/Head.astro";

interface Props {
    title: string;
    description: string;
    imgSrc?: string;
    imgAlt?: string;
    type?: "website" | "article";
    authorTwitter?: string;
}

const lang = Astro.currentLocale ?? "en";
---

<html lang={lang} dir={lang == "he" ? "rtl" : "ltr"}>
    <Head {...Astro.props}>
        <slot name="head" />
    </Head>
    <body>
        <slot />
    </body>
</html>

<style is:global>
    :root {
        --color-bg: oklch(0.986 0.014 84.583);
        --color-text: oklch(0.189 0.015 25.858);
        --color-blue: oklch(0.428 0.172 259.702);

        --font-size-sm: 1rem;
        --font-size-md: 1.25rem;
        --font-size-lg: 1.5rem;
        --font-size-xl: 1.75rem;
        --font-size-2xl: 2rem;
    }

    *,
    *::before,
    *::after {
        box-sizing: border-box;
        padding: 0;
    }

    *:not(dialog) {
        margin: 0;
    }

    html {
        scrollbar-color: var(--color-blue) transparent;
    }

    @media (prefers-reduced-motion: no-preference) {
        html {
            interpolate-size: allow-keywords;
            scroll-behavior: smooth;
        }
    }

    body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        line-height: 1.5;
        background-color: var(--color-bg);
        color: var(--color-text);
        font-family: var(--font-frank);
        font-size: var(--font-size-md);
    }

    img,
    picture,
    video,
    canvas,
    svg {
        display: block;
        max-width: 100%;
    }

    input,
    button,
    textarea,
    select {
        font: inherit;
    }

    p {
        text-wrap: pretty;
        overflow-wrap: break-word;
    }
    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
        text-wrap: balance;
        overflow-wrap: break-word;
        font-family: var(--font-suez);
    }
</style>
