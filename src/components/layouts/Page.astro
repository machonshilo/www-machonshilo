---
import Base from "@/components/layouts/Base.astro";
import Link from "@/components/Link.astro";
import Header from "@/components/ui/Header.astro";
import Footer from "@/components/ui/Footer.astro";

interface Props {
    title: string;
    description: string;
}

const { title, ...rest } = Astro.props;

const lang = Astro.currentLocale ?? "en";

const translations = {
    en: { skipLink: "Skip to main content" },
    he: { skipLink: "דלג לתוכן המרכזי" },
};

const props =
    translations[lang as keyof typeof translations] ?? translations.en;
---

<Base title=`${Astro.props.title} | Machon Shilo` {...rest}>
    <Link href="#content" class="sr-only focus:not-sr-only">
        {props.skipLink}
    </Link>
    <Header />
    <main id="content" class="py-2">
        <slot />
    </main>
    <Footer />
</Base>
